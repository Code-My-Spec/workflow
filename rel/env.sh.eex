#!/bin/sh
# Sourced by bin/workflow before it reads its command: `workflow sign-in`
# signs the loop in to its server (`Workflow.SignIn`), and `workflow init`
# writes its config.json (`Workflow.Init`), given its flags one per line.
if [ "$1" = "sign-in" ]; then
  exec "$RELEASE_ROOT/bin/$RELEASE_PROG" eval "Workflow.SignIn.main()"
fi

if [ "$1" = "init" ]; then
  shift
  WORKFLOW_INIT_ARGS=$(printf '%s\n' "$@")
  export WORKFLOW_INIT_ARGS
  exec "$RELEASE_ROOT/bin/$RELEASE_PROG" eval "Workflow.Init.main()"
fi
